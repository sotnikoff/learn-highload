          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"orders\"})",
          "legendFormat": "offset"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Ресурсы контейнеров",
      "collapsed": false,
      "gridPos": {
